    "TGS8100": {
      "family": "mox",
      "power_law_calibratable": false,
      "note": "Figaro TGS8100 MEMS MOS. Figaro publishes a single sensitivity ratio (Rs(10ppm H2)/Rs(air)~0.6) and an iso-butane curve, but NO power-law (a,b) coefficients. Relative-response channel only.",
      "sources": [
        "https://www.figarosensor.com/product/docs/TGS8100%280914%29.pdf",
        "http://www.figarosensor.com/feature/tgs8100.html"
      ]
    },
    "SGP30": {
      "family": "cmos_mems",
      "power_law_calibratable": false,
      "note": "Sensirion SGP30. Outputs processed eCO2 (ppm) and TVOC (ppb) via on-chip baseline algorithm; does NOT expose a resistance-to-concentration power law. Channel is usable as relative VOC index only.",
      "sources": [
        "https://sensirion.com/products/catalog/SGP30"
      ]
    },
    "SGP40": {
      "family": "cmos_mems",
      "power_law_calibratable": false,
      "note": "Sensirion SGP40. Outputs a processed VOC index (0-500) via on-chip algorithm; no resistance power law to a target gas. Relative VOC index channel only.",
      "sources": [
        "https://www.sensirion.com/products/catalog/SGP40"
      ]
    },
    "BME680": {
      "family": "mox",
      "power_law_calibratable": false,
      "note": "Bosch BME680. Outputs raw MOX gas resistance (kOhm) but is documented as a relative VOC sensor with NO per-gas concentration power law; Bosch only provides the closed-source BSEC library for IAQ. Relative-response channel only.",
      "sources": [
        "https://www.bosch-sensortec.com/media/boschsensortec/downloads/datasheets/bst-bme680-ds001.pdf",
        "https://www.bosch-sensortec.com/en/products/environmental-sensors/gas-sensors/bme680"
      ]
    }
